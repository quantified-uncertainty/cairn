---
// The two-axes map of reasoning processes: cost per validated bit (x) vs.
// cost to corrupt (y). Coordinates are first-pass qualitative judgments (v0)
// derived from the ratings in the Process Catalogue, on a 0–100 scale.
// label dx/dy/anchor place each label by hand to avoid collisions.

type Family = 'resolution' | 'institutional' | 'ai';

interface ProcessPoint {
	name: string;
	x: number; // info cost: 0 = cheap, 100 = expensive
	y: number; // corruption cost: 0 = cheap to corrupt, 100 = expensive
	family: Family;
	dx: number;
	dy: number;
	anchor: 'start' | 'middle' | 'end';
}

const points: ProcessPoint[] = [
	{ name: 'Formal proof', x: 80, y: 92, family: 'resolution', dx: 0, dy: -10, anchor: 'middle' },
	{ name: 'Full replication', x: 90, y: 84, family: 'resolution', dx: 0, dy: 18, anchor: 'end' },
	{ name: 'Forecaster track records', x: 48, y: 80, family: 'resolution', dx: -10, dy: 4, anchor: 'end' },
	{ name: 'Real-money market (Kalshi-style)', x: 54, y: 67, family: 'resolution', dx: -10, dy: 4, anchor: 'end' },
	{ name: 'Output-metered market', x: 62, y: 73, family: 'resolution', dx: 10, dy: 4, anchor: 'start' },
	{ name: 'Tournament (Metaculus-style)', x: 50, y: 56, family: 'resolution', dx: 10, dy: 4, anchor: 'start' },
	{ name: 'Play-money market', x: 30, y: 28, family: 'resolution', dx: 10, dy: 4, anchor: 'start' },
	{ name: 'Courts', x: 84, y: 64, family: 'institutional', dx: 10, dy: 4, anchor: 'start' },
	{ name: 'Expert panel', x: 44, y: 46, family: 'institutional', dx: -10, dy: 4, anchor: 'end' },
	{ name: 'Financial audit', x: 46, y: 30, family: 'institutional', dx: 10, dy: 4, anchor: 'start' },
	{ name: 'Peer review', x: 52, y: 22, family: 'institutional', dx: 10, dy: 4, anchor: 'start' },
	{ name: 'Composite indices', x: 10, y: 7, family: 'institutional', dx: 10, dy: 4, anchor: 'start' },
	{ name: 'Online reviews', x: 19, y: 13, family: 'institutional', dx: 10, dy: 4, anchor: 'start' },
	{ name: 'Debate protocol', x: 58, y: 50, family: 'ai', dx: 10, dy: 4, anchor: 'start' },
	{ name: 'Consistency battery', x: 13, y: 33, family: 'ai', dx: 10, dy: 4, anchor: 'start' },
	{ name: 'Multi-model LLM panel', x: 9, y: 24, family: 'ai', dx: 10, dy: 4, anchor: 'start' },
	{ name: 'Single LLM judge', x: 6, y: 14, family: 'ai', dx: 10, dy: 4, anchor: 'start' },
];

const familyMeta: Record<Family, { color: string; label: string }> = {
	resolution: { color: '#3b82f6', label: 'Grounded in resolution / track records' },
	institutional: { color: '#d97706', label: 'Institutional judgment' },
	ai: { color: '#10b981', label: 'AI-native' },
};

const W = 760;
const H = 560;
const M = { left: 64, right: 24, top: 36, bottom: 96 };
const px = (x: number) => M.left + (x / 100) * (W - M.left - M.right);
const py = (y: number) => H - M.bottom - (y / 100) * (H - M.top - M.bottom);

const families: Family[] = ['resolution', 'institutional', 'ai'];
---

<figure class="process-map">
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Scatter plot of reasoning processes by cost per validated bit and cost to corrupt">
		{/* gridlines */}
		{[25, 50, 75, 100].map((v) => (
			<>
				<line x1={px(v)} y1={py(0)} x2={px(v)} y2={py(100)} class="grid" />
				<line x1={px(0)} y1={py(v)} x2={px(100)} y2={py(v)} class="grid" />
			</>
		))}

		{/* the empty quadrant */}
		<rect
			x={px(0)} y={py(100)}
			width={px(35) - px(0)} height={py(55) - py(100)}
			class="empty-quadrant"
		/>
		<text x={px(2.5)} y={py(96)} class="quadrant-label">The empty quadrant</text>
		<text x={px(2.5)} y={py(91)} class="quadrant-sublabel">cheap to run, expensive to corrupt —</text>
		<text x={px(2.5)} y={py(86)} class="quadrant-sublabel">nothing lives here yet</text>

		{/* axes */}
		<line x1={px(0)} y1={py(0)} x2={px(100)} y2={py(0)} class="axis" />
		<line x1={px(0)} y1={py(0)} x2={px(0)} y2={py(100)} class="axis" />
		<text x={(px(0) + px(100)) / 2} y={H - M.bottom + 38} text-anchor="middle" class="axis-label">
			Cost per validated bit →
		</text>
		<text
			x={-((py(0) + py(100)) / 2)} y={20}
			text-anchor="middle" transform="rotate(-90)" class="axis-label"
		>
			Cost to corrupt →
		</text>
		<text x={px(0)} y={H - M.bottom + 18} text-anchor="start" class="tick">cheap</text>
		<text x={px(100)} y={H - M.bottom + 18} text-anchor="end" class="tick">expensive</text>
		<text x={px(0) - 8} y={py(0)} text-anchor="end" class="tick">easy</text>
		<text x={px(0) - 8} y={py(100) + 10} text-anchor="end" class="tick">hard</text>

		{/* points */}
		{points.map((p) => (
			<>
				<circle cx={px(p.x)} cy={py(p.y)} r="5.5" fill={familyMeta[p.family].color} class="dot" />
				<text
					x={px(p.x) + p.dx} y={py(p.y) + p.dy}
					text-anchor={p.anchor} class="point-label"
				>
					{p.name}
				</text>
			</>
		))}

		{/* legend */}
		{families.map((f, i) => (
			<>
				<circle cx={M.left + 8 + i * 235} cy={H - 22} r="5.5" fill={familyMeta[f].color} class="dot" />
				<text x={M.left + 20 + i * 235} y={H - 18} text-anchor="start" class="legend-label">
					{familyMeta[f].label}
				</text>
			</>
		))}
	</svg>
	<figcaption>
		Positions are version-0 qualitative judgments from the <a href="/concepts/process-catalogue/">Process Catalogue</a>,
		drawn to be argued with. Replacing them with measured coordinates is one of the field's central projects.
	</figcaption>
</figure>

<style>
	.process-map {
		margin: 1.5rem 0;
	}
	.process-map svg {
		width: 100%;
		height: auto;
		display: block;
	}
	.grid {
		stroke: var(--sl-color-hairline, #ddd);
		stroke-width: 1;
	}
	.axis {
		stroke: var(--sl-color-gray-2, #888);
		stroke-width: 1.5;
	}
	.axis-label {
		fill: var(--sl-color-text, #333);
		font-size: 14px;
		font-weight: 600;
	}
	.tick,
	.quadrant-sublabel,
	.legend-label {
		fill: var(--sl-color-gray-3, #777);
		font-size: 11.5px;
	}
	.quadrant-label {
		fill: var(--sl-color-text-accent, var(--sl-color-accent, #4f6df5));
		font-size: 13px;
		font-weight: 700;
	}
	.empty-quadrant {
		fill: var(--sl-color-accent-low, rgba(80, 110, 245, 0.08));
		fill-opacity: 0.35;
		stroke: var(--sl-color-text-accent, var(--sl-color-accent, #4f6df5));
		stroke-width: 1.5;
		stroke-dasharray: 6 5;
	}
	.dot {
		stroke: var(--sl-color-bg, #fff);
		stroke-width: 1.5;
	}
	.point-label {
		fill: var(--sl-color-text, #333);
		font-size: 12px;
	}
	.process-map figcaption {
		font-size: 0.85rem;
		color: var(--sl-color-gray-3, #777);
		margin-top: 0.25rem;
	}
</style>
